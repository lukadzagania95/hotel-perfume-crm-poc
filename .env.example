# Database (SQLite is appropriate for one running app instance with a persistent disk).
DATABASE_URL="file:./dev.db"
SEED_DEMO_DATA="true"

# Protects the CRM UI in production. Use long, unique values.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-long-random-password"
# Required behind a reverse proxy so authentication redirects remain on the public domain.
APP_BASE_URL="http://localhost:3000"

# Protects POST /api/cron/outbound and POST /api/cron/inbound (minimum 24 characters).
CRON_SECRET="replace-with-a-different-long-random-secret"

# Safe rollout switch. Keep these values during personal inbox testing.
EMAIL_DELIVERY_MODE="test"
EMAIL_LIVE_SEND_ENABLED="false"
EMAIL_TEST_RECIPIENT="your-email@example.com"

# Sender identity and SMTP connection. Gmail users should use an app password.
EMAIL_FROM_NAME="HOC Hotel Perfume"
EMAIL_FROM_ADDRESS="your-email@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="replace-with-app-password"

# Reply mailbox. It may use separate credentials from SMTP.
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER="your-email@example.com"
IMAP_PASSWORD="replace-with-app-password"
IMAP_MAILBOX="INBOX"
